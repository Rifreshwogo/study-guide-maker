# Copy this file to .env.local and fill in your key. Never commit .env.local.
ANTHROPIC_API_KEY=

# Optional: Upstash Redis for rate limiting that works across Vercel servers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: make guides with local models on this Mac instead of Claude.
# Needs Ollama running and local SearXNG (see README > Local mode). Never set on Vercel.
# AI_PROVIDER=local
# LOCAL_MODEL=qwen3-vl:8b-instruct
